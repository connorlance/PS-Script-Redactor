    # -- reusable scrollable area -------------------------------------------
    def _make_scroller(self, parent, bg):
        """Return (outer_frame, inner_frame). inner_frame scrolls vertically."""
        outer = tk.Frame(parent, bg=bg)
        canvas = tk.Canvas(outer, bg=bg, highlightthickness=0, bd=0)
        sb = make_scrollbar(outer, canvas.yview)
        canvas.configure(yscrollcommand=sb.set)
        sb.pack(side="right", fill="y")
        canvas.pack(side="left", fill="both", expand=True)

        inner = tk.Frame(canvas, bg=bg)
        win = canvas.create_window((0, 0), window=inner, anchor="nw")
        inner.bind("<Configure>",
                   lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.bind("<Configure>", lambda e: canvas.itemconfigure(win, width=e.width))

        def wheel(event):
            # let multi-line text boxes scroll themselves
            if isinstance(event.widget, tk.Text):
                return
            if getattr(event, "num", None) in (4, 5):
                step = -1 if event.num == 4 else 1
            else:
                step = -1 * (event.delta // 120 or (1 if event.delta < 0 else -1))
            canvas.yview_scroll(step, "units")

        def bind_wheel(_e=None):
            canvas.bind_all("<MouseWheel>", wheel)
            canvas.bind_all("<Button-4>", wheel)
            canvas.bind_all("<Button-5>", wheel)

        def unbind_wheel(_e=None):
            canvas.unbind_all("<MouseWheel>")
            canvas.unbind_all("<Button-4>")
            canvas.unbind_all("<Button-5>")

        outer.bind("<Enter>", bind_wheel)
        outer.bind("<Leave>", unbind_wheel)
        self.bind("<Destroy>", lambda e: unbind_wheel(), add="+")
        return outer, inner

