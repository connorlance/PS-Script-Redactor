# ---------------------------------------------------------------------------
# Settings load / save (written back into this file)
# ---------------------------------------------------------------------------
def _script_path():
    if getattr(sys, "frozen", False):
        return None
    try:
        return os.path.abspath(__file__)
    except NameError:
        return None


def _sidecar_path():
    base = os.path.dirname(os.path.abspath(sys.executable if getattr(sys, "frozen", False)
                                           else (_script_path() or sys.argv[0])))
    return os.path.join(base, "ps_redactor.settings.json")


def _merge(defaults, loaded):
    out = json.loads(json.dumps(defaults))
    if not isinstance(loaded, dict):
        return out
    for k, v in loaded.items():
        if k in out and isinstance(out[k], dict) and isinstance(v, dict):
            out[k].update(v)
        else:
            out[k] = v
    # detector keys added in later versions take their own default
    for k in DETECTOR_KEYS:
        out["detectors"].setdefault(k, DETECTOR_DEFAULTS[k])
    return out


def load_settings():
    data = {}
    side = _sidecar_path()
    if os.path.exists(side):
        try:
            with open(side, "r", encoding="utf-8") as fh:
                data = json.load(fh)
        except Exception:
            data = {}
    else:
        try:
            data = json.loads(EMBEDDED_SETTINGS.strip() or "{}")
        except Exception:
            data = {}
    return _merge(DEFAULT_SETTINGS, data)


def save_settings(cfg):
    """Rewrite the settings block inside this very file. Returns (ok, message)."""
    blob = json.dumps(cfg, indent=2, ensure_ascii=True).replace("'", r"\u0027")
    path = _script_path()
    if path and os.path.isfile(path):
        try:
            with open(path, "r", encoding="utf-8") as fh:
                src = fh.read()
            pattern = re.compile(
                r"(# <<<SETTINGS_BEGIN>>>\nEMBEDDED_SETTINGS = r'''\n)[\s\S]*?(\n'''\n# <<<SETTINGS_END>>>)")
            if not pattern.search(src):
                raise RuntimeError("settings block not found")
            new_src = pattern.sub(lambda m: m.group(1) + blob + m.group(2), src, count=1)
            folder = os.path.dirname(path)
            fd, tmp = tempfile.mkstemp(dir=folder, suffix=".tmp")
            with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as fh:
                fh.write(new_src)
            os.replace(tmp, path)
            return True, "Settings saved into %s" % os.path.basename(path)
        except Exception as exc:
            err = str(exc)
    else:
        err = "running frozen / no source file"
    # fallback
    try:
        with open(_sidecar_path(), "w", encoding="utf-8") as fh:
            json.dump(cfg, fh, indent=2)
        return True, "Saved to %s (could not write to the script: %s)" % (
            os.path.basename(_sidecar_path()), err)
    except Exception as exc:
        return False, "Could not save settings: %s" % exc


