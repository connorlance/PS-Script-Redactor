            ("redact_private_ips", "Redact private IP ranges (10.x, 192.168.x, 172.16-31.x)"),
            ("company_partial_match", "Match company names / terms inside longer words"),
            ("propagate_learned_names",
             "Once a username is found, redact that same value everywhere else in the script"),
            ("syntax_highlight", "PowerShell syntax highlighting in both boxes"),
        ]:
            var = tk.BooleanVar(value=True)
            self.opt_vars[key] = var
            make_check(opts, text, var, wraplength=320).pack(fill="x", padx=8, pady=1)
        tk.Frame(opts, bg=BG_PANEL, height=6).pack()

    # -- load / save ---------------------------------------------------------
    def _load_into_widgets(self, cfg):
        for k, var in self.det_vars.items():
            var.set(bool(cfg["detectors"].get(k, DETECTOR_DEFAULTS[k])))
        for k, var in self.opt_vars.items():
            var.set(bool(cfg["options"].get(k, DEFAULT_SETTINGS["options"][k])))
        self.txt_company.delete("1.0", "end")
        self.txt_company.insert("1.0", "\n".join(cfg.get("company_names", [])))
        self.txt_terms.delete("1.0", "end")
        self.txt_terms.insert("1.0", "\n".join(cfg.get("extra_terms", [])))
        self.txt_allow.delete("1.0", "end")
        self.txt_allow.insert("1.0", "\n".join(cfg.get("allowlist", [])))
        self.txt_custom.delete("1.0", "end")
        self.txt_custom.insert("1.0", "\n".join(
            "%s = %s" % (p.get("label", "REDACTED"), p.get("pattern", ""))
            for p in cfg.get("custom_patterns", [])))

    def _restore(self):
        if messagebox.askyesno("Restore defaults",
                               "Reset every setting back to defaults?", parent=self):
            self._load_into_widgets(json.loads(json.dumps(DEFAULT_SETTINGS)))

    @staticmethod
    def _lines(widget):
        return [ln.strip() for ln in widget.get("1.0", "end").splitlines() if ln.strip()]

    def _save(self):
        cfg = json.loads(json.dumps(DEFAULT_SETTINGS))
        cfg["detectors"] = {k: bool(v.get()) for k, v in self.det_vars.items()}
        cfg["options"] = {k: bool(v.get()) for k, v in self.opt_vars.items()}
        cfg["company_names"] = self._lines(self.txt_company)
        cfg["extra_terms"] = self._lines(self.txt_terms)
        cfg["allowlist"] = self._lines(self.txt_allow)

        patterns, bad = [], []
        for line in self._lines(self.txt_custom):
            if "=" not in line:
                bad.append(line)
                continue
            label, pat = line.split("=", 1)
            label, pat = label.strip().upper() or "REDACTED", pat.strip()
            try:
                re.compile(pat)
            except re.error as exc:
                bad.append("%s  (%s)" % (line, exc))
                continue
            patterns.append({"label": label, "pattern": pat})
        cfg["custom_patterns"] = patterns

        if bad:
            messagebox.showwarning(
                "Some custom patterns were skipped",
                "These lines aren't valid 'LABEL = regex' entries:\n\n" + "\n".join(bad),
                parent=self)

        ok, msg = save_settings(cfg)
        if not ok:
            messagebox.showerror("Settings", msg, parent=self)
            return
        self.on_save(cfg, msg)
        self.destroy()


