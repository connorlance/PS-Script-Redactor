        bar.pack(fill="x", side="top")
        inner = tk.Frame(bar, bg=BG_PANEL)
        inner.pack(fill="x", padx=12, pady=8)

        tk.Label(inner, text="PowerShell Redactor", bg=BG_PANEL, fg=FG,
                 font=(UI_FONT[0], UI_FONT[1] + 3, "bold")).pack(side="left")

        make_button(inner, "Settings", self.open_settings).pack(side="right")
        make_button(inner, "Clear", self.clear_input).pack(side="right", padx=8)
        make_button(inner, "Open file…", self.open_file).pack(side="right")

        tk.Frame(self, bg=BORDER, height=1).pack(fill="x")

    def _build_panes(self):
        self.panes = tk.PanedWindow(self, orient="vertical", bg=BG, sashwidth=6,
                                    sashrelief="flat", bd=0, showhandle=False)
        self.panes.pack(fill="both", expand=True, padx=12, pady=12)

        # ---- input ----
        top = tk.Frame(self.panes, bg=BG)
        tk.Label(top, text="Script", bg=BG, fg=FG_DIM, font=UI_FONT,
                 anchor="w").pack(fill="x", pady=(0, 4))
        self.in_wrap = wrap = tk.Frame(top, bg=BORDER, highlightthickness=0)
        wrap.pack(fill="both", expand=True)

        self.gutter = tk.Text(wrap, width=5, bg=GUTTER_BG, fg=GUTTER_FG, bd=0,
                              relief="flat", font=MONO, padx=6, pady=6,
                              highlightthickness=0, takefocus=0, cursor="arrow",
                              state="disabled", wrap="none")
        self.gutter.pack(side="left", fill="y", padx=(1, 0), pady=1)

        self.input = tk.Text(wrap, bg=BG_INPUT, fg=FG, insertbackground="#ffffff",
                             selectbackground=SEL_BG, relief="flat", bd=0,
                             font=MONO, padx=8, pady=6, wrap="none",
                             highlightthickness=0, undo=True, tabs="    ")
        self.input.pack(side="left", fill="both", expand=True, pady=1)

        self.in_scroll = make_scrollbar(wrap, self._scroll_input)
        self.in_scroll.pack(side="right", fill="y", padx=(0, 1), pady=1)

        self.input.configure(yscrollcommand=self._on_input_scroll)

        xscroll = make_scrollbar(top, self.input.xview)
        xscroll.configure(orient="horizontal", width=12)
        xscroll.pack(fill="x")
        self.input.configure(xscrollcommand=xscroll.set)

        for tag, color in SYNTAX.items():
            self.input.tag_configure(tag, foreground=color)
        self.input.tag_configure("comment", foreground=SYNTAX["comment"])

        self.input.bind("<<Modified>>", self._on_modified)
        self.input.bind("<MouseWheel>", lambda e: self.after(1, self._sync_gutter))
        self.input.bind("<Button-4>", lambda e: self.after(1, self._sync_gutter))
        self.input.bind("<Button-5>", lambda e: self.after(1, self._sync_gutter))

        self.panes.add(top, stretch="always", minsize=140)

        # ---- output ----
        bottom = tk.Frame(self.panes, bg=BG)
        head = tk.Frame(bottom, bg=BG)
        head.pack(fill="x", pady=(0, 4))
        tk.Label(head, text="Redacted", bg=BG, fg=FG_DIM, font=UI_FONT).pack(side="left")
        self.count_label = tk.Label(head, text="", bg=BG, fg=REDACT_BG,
                                    font=(UI_FONT[0], UI_FONT[1], "bold"))
        self.count_label.pack(side="left", padx=10)

        nav = tk.Frame(head, bg=BG)
        nav.pack(side="left")

        def nav_button(glyph, cmd):
            b = tk.Button(nav, text=glyph, command=cmd, bg=BG, fg=FG_DIM,
                          activebackground=BG_BUTTON, activeforeground="#ffffff",
                          relief="flat", bd=0, padx=6, pady=0, font=UI_FONT,
                          cursor="hand2", highlightthickness=0,
                          disabledforeground=BORDER)
            b.pack(side="left")
            return b

        self.prev_btn = nav_button("\u25b2", lambda: self._goto_redaction(-1))
        self.next_btn = nav_button("\u25bc", lambda: self._goto_redaction(1))
        self.pos_label = tk.Label(nav, text="", bg=BG, fg=FG_DIM, font=UI_FONT)
        self.pos_label.pack(side="left", padx=(6, 0))

        # buttons and scrollbar are packed against the bottom edge first, so the
        # output box gives up space instead of the buttons being clipped
        btns = tk.Frame(bottom, bg=BG)
        btns.pack(side="bottom", fill="x", pady=(10, 0))
        btns.columnconfigure(0, weight=1, uniform="b")
        btns.columnconfigure(1, weight=1, uniform="b")
        make_button(btns, "Copy redacted text", self.copy_output).grid(
            row=0, column=0, sticky="ew", padx=(0, 6), ipady=3)
        make_button(btns, "Export to file…", self.export_file, accent=True).grid(
            row=0, column=1, sticky="ew", padx=(6, 0), ipady=3)

        oxsb = make_scrollbar(bottom, lambda *a: self.output.xview(*a))
        oxsb.configure(orient="horizontal", width=12)
        oxsb.pack(side="bottom", fill="x")

        owrap = tk.Frame(bottom, bg=BORDER)
        owrap.pack(side="top", fill="both", expand=True)
        self.output = tk.Text(owrap, bg=BG_INPUT, fg=FG, relief="flat", bd=0,
                              font=MONO, padx=8, pady=6, wrap="none",
                              highlightthickness=0, insertbackground=BG_INPUT,
                              selectbackground=SEL_BG)
        self.output.pack(side="left", fill="both", expand=True, padx=(1, 0), pady=1)
        osb = make_scrollbar(owrap, self.output.yview)
        osb.pack(side="right", fill="y", padx=(0, 1), pady=1)
        self.output.configure(yscrollcommand=osb.set)
        self.output.configure(xscrollcommand=oxsb.set)
        for tag, color in SYNTAX.items():
            self.output.tag_configure(tag, foreground=color)
        self.output.tag_configure("redact", background=REDACT_BG, foreground=REDACT_FG,
                                  font=(MONO[0], MONO[1], "bold"))
        self.output.tag_raise("redact")   # always wins over the syntax colours
        self.output.configure(state="disabled")

        self.panes.add(bottom, stretch="always", minsize=210)

    def _build_footer(self):
        self.status = tk.Label(self, text="", bg=BG_PANEL, fg=FG_DIM, anchor="w",
                               font=UI_FONT, padx=12, pady=5)
        self.status.pack(fill="x", side="bottom")

    # -- gutter / scroll sync ------------------------------------------------
    def _scroll_input(self, *args):
        self.input.yview(*args)
        self._sync_gutter()

    def _on_input_scroll(self, first, last):
        self.in_scroll.set(first, last)
        self.gutter.yview_moveto(first)

    def _sync_gutter(self):
        first, _ = self.input.yview()
        self.gutter.yview_moveto(first)

    def _update_gutter(self):
        lines = int(self.input.index("end-1c").split(".")[0])
        content = "\n".join(str(i).rjust(4) for i in range(1, lines + 1))
        self.gutter.configure(state="normal")
        self.gutter.delete("1.0", "end")
        self.gutter.insert("1.0", content)
        self.gutter.configure(state="disabled")
        self._sync_gutter()

    # -- events --------------------------------------------------------------
    def _on_modified(self, event=None):
        if not self.input.edit_modified():
            return
        self.input.edit_modified(False)
        self._update_gutter()
        if self.cfg["options"].get("syntax_highlight", True):
            if self._highlight_job:
                self.after_cancel(self._highlight_job)
            self._highlight_job = self.after(180, self.highlight_input)
        if self._redact_job:
            self.after_cancel(self._redact_job)
        self._redact_job = self.after(320, self.run_redaction)

    def highlight_input(self):
        self._highlight_job = None
        text = self.input.get("1.0", "end-1c")
        for tag in SYNTAX:
            self.input.tag_remove(tag, "1.0", "end")
        if not text or len(text) > 400000:
            return
        for start, end, tag in tokenize_powershell(text):
            self.input.tag_add(tag,
                               "1.0+%dc" % start,
                               "1.0+%dc" % end)

    def run_redaction(self):
        self._redact_job = None
        text = self.input.get("1.0", "end-1c")
        segments, counts = redact(text, self.cfg)

        out_parts, spans, pos = [], [], 0
        for kind, chunk in segments:
            out_parts.append(chunk)
            if kind == "redact":
                spans.append((pos, pos + len(chunk)))
            pos += len(chunk)
        out_text = "".join(out_parts)

        self.output.configure(state="normal")
        self.output.delete("1.0", "end")
        for tag in SYNTAX:
            self.output.tag_remove(tag, "1.0", "end")
        self.output.insert("1.0", out_text)

        if self.cfg["options"].get("syntax_highlight", True) and len(out_text) <= 400000:
            for a, b, tag in tokenize_powershell(out_text):
                self.output.tag_add(tag, "1.0+%dc" % a, "1.0+%dc" % b)
        for a, b in spans:
            self.output.tag_add("redact", "1.0+%dc" % a, "1.0+%dc" % b)
        self.output.tag_raise("redact")
        self.output.configure(state="disabled")

        # navigation always starts on redaction #1
        self._spans = spans
        self._span_index = 0
        self._nav_used = False
        if spans:
            a, b = spans[0]
            self.prev_btn.configure(state="normal")
            self.next_btn.configure(state="normal")
            self.pos_label.configure(text="1 / %d" % len(spans))
            self.output.see("1.0+%dc+3l" % b)
            self.output.see("1.0+%dc" % a)
        else:
            self.prev_btn.configure(state="disabled")
            self.next_btn.configure(state="disabled")
            self.pos_label.configure(text="")

        total = sum(counts.values())
        self.count_label.configure(
            text="%d redaction%s" % (total, "" if total == 1 else "s") if total else "")
        if total:
            breakdown = ", ".join("%d x %s" % (n, lab)
                                  for lab, n in counts.most_common(8))
            extra = "" if len(counts) <= 8 else ", …"
            self.set_status(breakdown + extra)
        else:
            self.set_status("Nothing matched." if text.strip()
                            else "Paste a PowerShell script above.")

    def _update_nav(self):
        total = len(self._spans)
        state = "normal" if total else "disabled"
        self.prev_btn.configure(state=state)
        self.next_btn.configure(state=state)
        if not total:
            self.pos_label.configure(text="")
        else:
            self.pos_label.configure(text="%d / %d" % (self._span_index + 1, total))

    def _goto_redaction(self, step):
        if not self._spans:
            return
        if not self._nav_used:
            # first press just scrolls to #1, which is already selected
            self._nav_used = True
            if step < 0:
                self._span_index = len(self._spans) - 1
        else:
            self._span_index = (self._span_index + step) % len(self._spans)
        a, b = self._spans[self._span_index]
        start, end = "1.0+%dc" % a, "1.0+%dc" % b
        self.output.see("%s+3l" % end)
        self.output.see(start)
        self._update_nav()

    def set_status(self, msg):
        self.status.configure(text=msg)

    # -- actions -------------------------------------------------------------
    def clear_input(self):
        self.input.delete("1.0", "end")
        self.input.edit_modified(True)
        self._on_modified()

    def open_file(self):
        path = filedialog.askopenfilename(
            title="Open script",
            filetypes=[("PowerShell", "*.ps1 *.psm1 *.psd1"),
                       ("Text", "*.txt"), ("All files", "*.*")])
        if not path:
            return
        try:
            with open(path, "r", encoding="utf-8-sig", errors="replace") as fh:
                data = fh.read()
        except Exception as exc:
            messagebox.showerror(APP_NAME, "Could not open file:\n%s" % exc)
            return
        self.input.delete("1.0", "end")
        self.input.insert("1.0", data)
        self.input.edit_modified(True)
        self._on_modified()
        self.set_status("Loaded %s" % os.path.basename(path))

    def copy_output(self):
        text = self.output.get("1.0", "end-1c")
        if not text.strip():
            self.set_status("Nothing to copy yet.")
            return
        self.clipboard_clear()
        self.clipboard_append(text)
        self.update()
        self.set_status("Redacted text copied to clipboard.")

    def export_file(self):
        text = self.output.get("1.0", "end-1c")
        if not text.strip():
            self.set_status("Nothing to export yet.")
            return
        path = filedialog.asksaveasfilename(
            title="Export redacted script", defaultextension=".ps1",
            initialfile="redacted.ps1",
            filetypes=[("PowerShell", "*.ps1"), ("Text", "*.txt"), ("All files", "*.*")])
        if not path:
            return
        try:
            with open(path, "w", encoding="utf-8", newline="\r\n") as fh:
                fh.write(text)
        except Exception as exc:
            messagebox.showerror(APP_NAME, "Could not save file:\n%s" % exc)
            return
        self.set_status("Exported to %s" % path)

    def open_settings(self):
        SettingsWindow(self, self.cfg, self._settings_saved)

    def _settings_saved(self, cfg, msg):
        self.cfg = cfg
        self.run_redaction()
        if not self.cfg["options"].get("syntax_highlight", True):
            for tag in SYNTAX:
                self.input.tag_remove(tag, "1.0", "end")
        else:
            self.highlight_input()
        self.set_status(msg)


def main():
    app = RedactorApp()
    app.mainloop()


if __name__ == "__main__":
    main()
