def _valid_ipv4(val, cfg):
    parts = val.split(".")
    if len(parts) != 4:
        return False
    try:
        nums = [int(p) for p in parts]
    except ValueError:
        return False
    if any(n > 255 for n in nums):
        return False
    if not cfg["options"].get("redact_private_ips", True):
        if nums[0] == 10:
            return False
        if nums[0] == 192 and nums[1] == 168:
            return False
        if nums[0] == 172 and 16 <= nums[1] <= 31:
            return False
        if nums[0] == 127:
            return False
    return True


def _not_inside_path(text, start):
    """Reject DOMAIN\\user matches that are really part of a file path."""
    line_start = text.rfind("\n", 0, start) + 1
    before = text[line_start:start]
    tail = before[-60:]
    return (":" not in tail) and ("\\" not in tail) and ("/" not in tail)


_GUID_CONTEXT = [
    ("tenant", "TENANT ID"),
    ("directoryid", "TENANT ID"),
    ("subscription", "SUBSCRIPTION ID"),
    ("client", "APP ID"),
    ("appid", "APP ID"),
    ("application", "APP ID"),
    ("object", "OBJECT ID"),
    ("group", "GROUP ID"),
    ("site", "SITE ID"),
    ("list", "LIST ID"),
    ("user", "USER ID"),
    ("mailbox", "MAILBOX ID"),
]


def _guid_label(text, start):
    ctx = text[max(0, start - 70):start].lower().replace(" ", "").replace("_", "").replace("-", "")
    for needle, label in _GUID_CONTEXT:
        if needle in ctx:
            return label
    return "GUID"


def _word_group(words, partial=False):
    parts = [re.escape(w.strip()) for w in words if w.strip()]
    if not parts:
        return None
    parts.sort(key=len, reverse=True)
    body = "|".join(parts)
    if partial:
        return "(?i)(?:%s)" % body
    return r"(?i)(?<![A-Za-z0-9])(?:%s)(?![A-Za-z0-9])" % body


LEARN_KEYS = ("account_assignment", "account_param")
LEARNABLE_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._@\\\- ]{2,63}$")


def build_detectors(cfg, learned=None):
    dets = []
    enabled = cfg.get("detectors", {})
    for spec in DETECTOR_SPECS:
        if not enabled.get(spec["key"], True):
            continue
        try:
            rx = re.compile(spec["pattern"])
            sub = re.compile(spec["sub_pattern"]) if spec.get("sub_pattern") else None
        except re.error:
            continue
        d = dict(spec)
        d["regex"] = rx
        d["_sub"] = sub
        d.setdefault("group", 0)
        dets.append(d)

    comp = _word_group(cfg.get("company_names", []),
                       cfg["options"].get("company_partial_match", False))
    if comp:
        dets.append(dict(key="company", placeholder="COMPANY", prio=82, group=0,
                         regex=re.compile(comp), _sub=None, cat="Custom"))

    terms = _word_group(cfg.get("extra_terms", []),
                        cfg["options"].get("company_partial_match", False))
    if terms:
        dets.append(dict(key="extra_terms", placeholder="REDACTED", prio=82, group=0,
                         regex=re.compile(terms), _sub=None, cat="Custom"))

    for item in cfg.get("custom_patterns", []):
        pat = (item.get("pattern") or "").strip()
        lab = (item.get("label") or "REDACTED").strip().upper()
        if not pat:
            continue
        try:
            rx = re.compile(pat)
        except re.error:
            continue
        dets.append(dict(key="custom:" + lab, placeholder=lab, prio=97, group=0,
                         regex=rx, _sub=None, cat="Custom"))

    if learned:
        grp = _word_group(sorted(learned)[:200], False)
        if grp:
            dets.append(dict(key="learned_name", placeholder="USERNAME", prio=83,
                             group=0, regex=re.compile(grp), _sub=None, cat="Custom"))
    return dets


_ALLOW_BEFORE = ("", ".", "/", "@", "\\", " ", "\"", "'", "=", "(", "[")
_ALLOW_AFTER = ("", "/", ":", " ", "\"", "'", ")", "]", ",", ";", "?", "#")


def _allowed(val, allow):
    """True if val is an allow-listed endpoint. Matches on token boundaries, so
    an entry like ::1 does not allow-list fe80::1ff:fe23:4567:890a."""
    low = val.lower()
    for a in allow:
        if not a:
            continue
        if low == a:
            return True
        idx = 0
        while True:
            i = low.find(a, idx)
            if i < 0:
                break
            before = low[i - 1] if i else ""
            after = low[i + len(a):i + len(a) + 1]
            if before in _ALLOW_BEFORE and after in _ALLOW_AFTER:
                return True
            idx = i + 1
    return False


def _collect(text, cfg, dets, allow):
    found = []
    for d in dets:
        grp = d.get("group", 0)
        try:
            iterator = list(d["regex"].finditer(text))
        except Exception:
            continue
        for m in iterator:
            spans = []
            if d.get("_sub") is not None:
                base = m.start()
                for sm in d["_sub"].finditer(m.group(0)):
                    spans.append((base + sm.start(1), base + sm.end(1)))
            else:
                try:
                    spans = [m.span(grp)]
                except Exception:
                    continue
            for s, e in spans:
                if s < 0 or e <= s:
                    continue
                val = text[s:e]
                if not val.strip() or val.strip().startswith("$"):
                    continue
                # the allow list protects public endpoints; it never overrides your
                # own company names / terms / custom patterns
                if d["key"] not in ("company", "extra_terms", "learned_name") and \
                        not d["key"].startswith("custom:") and \
                        _allowed(val, allow):
                    continue
                if d["key"] == "ipv4" and not _valid_ipv4(val, cfg):
                    continue
                if d["key"] == "domain_user" and not _not_inside_path(text, s):
                    continue
                label = _guid_label(text, s) if d["key"] == "guid" else d["placeholder"]
                found.append((s, e, label, val, d["prio"], d["key"]))
    return found


def _resolve(found):
    found.sort(key=lambda t: (-t[4], -(t[1] - t[0]), t[0]))
    accepted = []
    for s, e, label, val, prio, key in found:
        if any(not (e <= a_s or s >= a_e) for a_s, a_e, _, _, _ in accepted):
            continue
        accepted.append((s, e, label, val, key))
    accepted.sort(key=lambda t: t[0])
    return accepted


def redact(text, cfg):
    """Return (segments, counts). segments = list of ('text'|'redact', string)."""
    if not text:
        return [], Counter()

    allow = [a.strip().lower() for a in cfg.get("allowlist", []) if a.strip()]
    dets = build_detectors(cfg)
    accepted = _resolve(_collect(text, cfg, dets, allow))

    # second pass: a name found in an account context is redacted everywhere else
    if cfg["options"].get("propagate_learned_names", True):
        learned = set()
        for _, _, label, val, key in accepted:
            if key in LEARN_KEYS and LEARNABLE_RE.match(val.strip()):
                learned.add(val.strip())
        if learned:
            dets = build_detectors(cfg, learned=learned)
            accepted = _resolve(_collect(text, cfg, dets, allow))

    number = cfg["options"].get("number_placeholders", True)

    # a label is only numbered when the script contains more than one distinct
    # value for it: one email is <EMAIL ADDRESS>, three are <EMAIL ADDRESS 1..3>
    order = {}
    for _, _, label, val, _ in accepted:
        vals = order.setdefault(label, [])
        v = val.strip().lower()
        if v not in vals:
            vals.append(v)

    counts = Counter()
    segments = []
    cursor = 0
    for s, e, label, val, key in accepted:
        if s > cursor:
            segments.append(("text", text[cursor:s]))
        if number and len(order[label]) > 1:
            token = "<%s %d>" % (label, order[label].index(val.strip().lower()) + 1)
        else:
            token = "<%s>" % label
        segments.append(("redact", token))
        counts[label] += 1
        cursor = e
    if cursor < len(text):
        segments.append(("text", text[cursor:]))
    return segments, counts


# ---------------------------------------------------------------------------
# PowerShell syntax highlighting
# ---------------------------------------------------------------------------
PS_KEYWORDS = (
    "begin|break|catch|class|continue|data|define|do|dynamicparam|else|elseif|end|"
    "enum|exit|filter|finally|for|foreach|from|function|hidden|if|in|inlinescript|"
    "param|process|return|static|switch|throw|trap|try|until|using|var|while|"
    "workflow|parallel|sequence|true|false|null"
)
PS_OPERATORS = (
    "eq|ne|gt|ge|lt|le|like|notlike|match|notmatch|contains|notcontains|in|notin|"
    "replace|split|join|is|isnot|as|and|or|xor|not|band|bor|bnot|bxor|shl|shr|f"
)

PS_TOKEN_RE = re.compile(
    r"(?P<block_comment><\#[\s\S]*?\#>)"
    r"|(?P<comment>\#[^\r\n]*)"
    r"|(?P<herestring>@(?P<hq>[\"'])[\s\S]*?(?P=hq)@)"
    r"|(?P<dstring>\"(?:[^\"`]|`[\s\S])*\")"
    r"|(?P<sstring>'(?:[^']|'')*')"
    r"|(?P<type>\[[A-Za-z_][\w.]*(?:\[\])?\])"
    r"|(?P<variable>\$(?:\{[^}\r\n]*\}|[\w:]+))"
    r"|(?P<operator>(?i:-(?:" + PS_OPERATORS + r")\b))"
    r"|(?P<cmdlet>\b[A-Za-z]{2,}-[A-Za-z][A-Za-z0-9]*\b)"
    r"|(?P<param>(?<![\w\-])-[A-Za-z][A-Za-z0-9]*\b)"
    r"|(?P<keyword>(?i:\b(?:" + PS_KEYWORDS + r")\b))"
    r"|(?P<number>\b\d+(?:\.\d+)?\b)"
)

VAR_IN_STRING_RE = re.compile(r"\$(?:\{[^}\r\n]*\}|[\w:]+)")

TOKEN_TAG = {
    "block_comment": "comment",
    "comment": "comment",
    "herestring": "string",
    "dstring": "string",
    "sstring": "string",
    "type": "type",
    "variable": "variable",
    "operator": "operator",
    "cmdlet": "cmdlet",
    "param": "param",
    "keyword": "keyword",
    "number": "number",
}


def tokenize_powershell(text):
    """Yield (start_index, end_index, tag) tuples."""
    for m in PS_TOKEN_RE.finditer(text):
        name = m.lastgroup
        if name == "hq":
            continue
        for gname in TOKEN_TAG:
            if m.group(gname) is not None:
                tag = TOKEN_TAG[gname]
                s, e = m.span(gname)
                yield (s, e, tag)
                if gname in ("dstring", "herestring") and m.group(gname).startswith(('"', '@"')):
                    for vm in VAR_IN_STRING_RE.finditer(text, s, e):
                        yield (vm.start(), vm.end(), "variable")
                break


